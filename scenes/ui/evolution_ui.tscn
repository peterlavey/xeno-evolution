[node name="PowerColumn" type="VBoxContainer" parent="VBoxContainer/Main"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Label" type="Label" parent="VBoxContainer/Main/PowerColumn"]
layout_mode = 2
